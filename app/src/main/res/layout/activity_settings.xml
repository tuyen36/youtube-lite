<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/settings_back_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="4dp"
            android:text="Cài đặt"
            android:textColor="#FFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hen gio tat -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Hẹn giờ tắt phát"
        android:textColor="#FFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/settings_sleep_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#AAA"
        android:textSize="12sp"
        android:text="Đang tắt" />

    <LinearLayout
        android:id="@+id/settings_sleep_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/settings_sleep_off"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Tắt"
            android:textSize="12sp" />

        <Button
            android:id="@+id/settings_sleep_30"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="30 phút"
            android:textSize="12sp" />

        <Button
            android:id="@+id/settings_sleep_60"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="1 giờ"
            android:textSize="12sp" />

        <Button
            android:id="@+id/settings_sleep_120"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="2 giờ"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Do phan giai mac dinh -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Độ phân giải mặc định khi phát"
        android:textColor="#FFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Video thiếu luồng đã chọn (720p/1080p) thì phát 480p"
        android:textColor="#AAA"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/settings_q360"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="360p"
            android:textSize="13sp" />

        <Button
            android:id="@+id/settings_q480"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="480p"
            android:textSize="13sp" />

        <Button
            android:id="@+id/settings_q720"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="720p"
            android:textSize="13sp" />

        <Button
            android:id="@+id/settings_q1080"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="1080p"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/settings_quality_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#AAA"
        android:textSize="12sp"
        android:text="Đang dùng: 360p" />

    <!-- Muc 2 UI/UX: thanh dieu huong chung -->
    <include
        android:id="@+id/nav_bar_container"
        layout="@layout/nav_bar" />

</LinearLayout>
